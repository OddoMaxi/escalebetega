APP_NAME="Escale Betega"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://escalebetega.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=escale_mysql
DB_PORT=3306
DB_DATABASE=escale_betega
DB_USERNAME=escale
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=.escalebetega.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=escale_redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

SMS_PROVIDER=interact
INTERACT_SMS_URL=https://sms.interactgroup.net/index.php
INTERACT_SMS_USER=
INTERACT_SMS_HASH=
INTERACT_SMS_FROM="ESC BETEGA"

VITE_APP_NAME="${APP_NAME}"
